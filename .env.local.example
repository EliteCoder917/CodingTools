# Copy this file to .env.local and fill in the values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

# Project URL (e.g. https://xxxxxxxx.supabase.co)
SUPABASE_URL=

# Service role key (server-side only — NEVER expose to the browser).
# Used by the Next.js server to read/write the database. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=
